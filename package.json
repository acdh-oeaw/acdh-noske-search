{
  "name": "acdh-noske-search",
  "version": "0.2.4",
  "type": "module",
  "main": "./dist/index.global.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.global.js"
  },
  "files": [
    "dist"
  ],
  "entry": [
    "index.ts"
  ],
  "scripts": {
    "build": "pnpm tailwindcss -i ./src/input.css -o ./src/style.css && tsup",
    "dev": "pnpm tailwindcss -i ./src/input.css -o ./src/style.css && vite",
    "build-vite": "tsc && vite build",
    "preview": "pnpm tailwindcss -i ./src/input.css -o ./src/style.css && vite preview"
  },
  "devDependencies": {
    "@acdh-oeaw/prettier-config": "^2.0.0",
    "@acdh-oeaw/tsconfig": "^1.0.2",
    "@hey-api/openapi-ts": "^0.43.0",
    "path": "^0.12.7",
    "prettier": "^3.3.1",
    "tailwindcss": "^3.4.3",
    "tsup": "^8.0.2",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "@acdh-oeaw/lib": "^0.1.12"
  },
  "keywords": [
    "Digital Edition",
    "TypeScript",
    "Search Interface",
    "Digital Humanities"
  ],
  "description": "Search Interface for Noske",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acdh-oeaw/acdh-noske-search.git"
  },
  "author": "Daniel Elsner",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/acdh-oeaw/acdh-noske-search/issues"
  },
  "homepage": "https://github.com/acdh-oeaw/acdh-noske-search#readme",
  "engines": {
    "node": "^20.x",
    "npm": "^10.x"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}